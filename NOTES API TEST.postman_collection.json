							"const expectedId = pm.environment.get('noteId');\r",
							"const expectedTitle = 'saya';\r",
							"const expectedTags = ['juga', 'manusia'];\r",
							"const expectedBody = 'apakah siapa yang bisa jadi dengan sengsara';\r",
